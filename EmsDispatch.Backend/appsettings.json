{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MongoDb": {
    "ConnectionString": "mongodb://localhost:27017",
    "DatabaseName": "ems_dispatch"
  },
  "Jwt": {
    "SecretKey": "your-super-secret-key-change-this-in-production-min-32-chars-long!!!",
