    "ExpirationMinutes": 60
  },
  "MLService": {
    "BaseUrl": "http://localhost:8000",
    "HospitalPredictionEndpoint": "/predict/hospital",
    "RouteOptimizationEndpoint": "/optimize/route"
  }
}
